#if 0 // 2>nul
@echo off
:: Removed .h file extension due to DGS
setlocal enabledelayedexpansion
chcp 65001 >nul

:: 1. Get absolute path of this script
set "SELF_PATH=%~f0"
set "TEMP_PATH=%~dp0temp_git_info.tmp"

:: 2. Get Git information
set "FULL_HASH="
for /f "tokens=1,2,3 delims=|" %%a in ('git -C "%~dp0." log -1 "--format=%%H|%%ai|%%an" 2^>nul') do (
    set "FULL_HASH=%%a"
    set "COMMIT_TIME=%%b"
    set "COMMIT_AUTHOR=%%c"
)

if "!FULL_HASH!"=="" (
    echo [Git Info] Git repository not detected
    set "SHORT_HASH=00000000"
    set "HEX_HASH=0x00000000"
    set "COMMIT_TIME=Unknown"
    set "COMMIT_AUTHOR=Unknown"
    set "IS_CLEAN_VAL=0"
    set "STATUS_TEXT=No Git"
    set "BUILD_AUTHOR=Unknown_User"
) else (
    rem Process remaining parameters if Git info was retrieved successfully
    set "SHORT_HASH=!FULL_HASH:~0,8!"
    set "HEX_HASH=0x!SHORT_HASH!"

    set "IS_CLEAN_VAL=1"
    set "STATUS_TEXT=Clean"
    for /f "delims=" %%a in ('git -C "%~dp0." status --porcelain 2^>nul') do (
        set "IS_CLEAN_VAL=0"
        set "STATUS_TEXT=Dirty"
    )

    set "BUILD_AUTHOR="
    for /f "delims=" %%a in ('git -C "%~dp0." config user.name 2^>nul') do set "BUILD_AUTHOR=%%a"
    if "!BUILD_AUTHOR!"=="" set "BUILD_AUTHOR=Unknown_User"
)

for /f "delims=" %%a in ('powershell -Command "Get-Date -Format 'yyyy-MM-dd HH:mm:ss'" 2^>nul') do set "CURRENT_TIME=%%a"

:: 3. Split script content before the marker
powershell -Command "$lines = [System.IO.File]::ReadAllLines($env:SELF_PATH); $idx = [array]::IndexOf($lines, '::---BAT_END_FLG---'); if ($idx -ge 0) { [System.IO.File]::WriteAllLines($env:TEMP_PATH, $lines[0..$idx]) }"

:: 4. Update C header code
(
echo #endif
echo.
echo /**
echo  * Auto-generated Git version info header file
echo  * Generated at: !CURRENT_TIME!
echo  */
echo.
echo #ifndef GIT_INFO_H
echo #define GIT_INFO_H
echo.
echo #include ^<stdint.h^>
echo.
echo // First 8 hex digits of Git commit hash
echo #define GIT_COMMIT_HASH_HEX     !HEX_HASH!
echo.
echo // Git commit hash string
echo #define GIT_COMMIT_HASH_STR     "!SHORT_HASH!"
echo.
echo // Working tree status: 1 = clean, 0 = uncommitted changes
echo #define GIT_IS_CLEAN            !IS_CLEAN_VAL!
echo #define GIT_STATUS_DESC         "!STATUS_TEXT!"
echo.
echo // Latest commit author
echo #define GIT_COMMIT_AUTHOR       "!COMMIT_AUTHOR!"
echo.
echo // Latest commit time
echo #define GIT_COMMIT_TIME         "!COMMIT_TIME!"
echo.
echo // Build author
echo #define BUILD_AUTHOR            "!BUILD_AUTHOR!"
echo.
echo // Firmware build/execution time
echo #define BUILD_EXECUTION_TIME    "!CURRENT_TIME!"
echo.
echo typedef struct {
echo     uint32_t hash;
echo     uint8_t is_clean;
echo     uint8_t commit_author[16];
echo     uint8_t commit_time[28];
echo     uint8_t build_author[16];
echo     uint8_t build_time[24];
echo } git_info_t;
echo.
echo extern const git_info_t git_info;
echo.
echo #if GIT_INFO_INIT
echo #if GIT_COMMIT_HASH_HEX ^> 0
echo #if GIT_IS_CLEAN ^^!= 1
echo #warning "git: Uncommitted changes^!"
echo #endif
echo const git_info_t git_info __attribute__((used^)^) = {
echo     .hash = GIT_COMMIT_HASH_HEX,
echo     .is_clean = GIT_IS_CLEAN,
echo     .commit_time = GIT_COMMIT_TIME,
echo     .commit_author = GIT_COMMIT_AUTHOR,
echo     .build_author = BUILD_AUTHOR,
echo     .build_time = BUILD_EXECUTION_TIME
echo };
echo #else
echo #error " GitInfo configuration error^! "
echo /*  1. Please ensure that git and Python are installed.
echo  * 2. Please ensure that GitInfo(https://github.com/carithers/g_KeilGitInfo/release^) is installed.
echo  * 3. Please ensure that the project is tracked with git.
echo  * 4. Please ensure that in
echo  *     Keil -^> Options for Target (magic wand^) -^> User -^> Before Build/Rebuild,
echo  *         [  cmd /Q /c "ren .\RTE\GitInfo\git_info git_info.bat & .\RTE\GitInfo\git_info.bat & ren .\RTE\GitInfo\git_info.bat git_info" ] has been added (and checked/ticked^).
echo  * 5. git init
echo  * 6. git add .
echo  * 7. git commit -m init
echo  * { doc: https://github.com/carithers/g_KeilGitInfo }
echo  */
echo #endif
echo #endif
echo.
echo #endif // GIT_INFO_H
echo.
) >> "%TEMP_PATH%"

:: 5. Replace self with updated file
(
    move /y "%TEMP_PATH%" "%SELF_PATH%" >nul
    echo [Git Info] Updated successfully. Current version: !SHORT_HASH!
    exit /b 0
)
